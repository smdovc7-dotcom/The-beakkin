{
  "name": "Backrooms Oyunu",
  "short_name": "Backrooms",
  "description": "Maraqlı Backrooms HTML oyunu",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "az",
  "dir": "ltr",
  "categories": [
    "games",
    "entertainment"
  ],
  "shortcuts": [
    {
      "name": "Oyuna Başla",
      "short_name": "Oyna",
      "description": "Dərhal oyuna daxil ol",
      "url": "/index.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": "auto"
  },
  "file_handlers": [
    {
      "action": "/index.html",
      "accept": {
        "image/png": [".png"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+backrooms",
      "url": "/index.html?value=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/index.html"
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
