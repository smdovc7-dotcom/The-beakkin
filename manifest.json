{
  "name": "Backrooms Oyunu",
  "short_name": "Backrooms",
  "description": "Maraqlı Backrooms HTML oyunu",
  "start_url": "/index.htmlhttps://github.com/smdovc7-dotcom/The-beakkin/blob/main/index.html",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "az",
  "dir": "ltr",
  "categories": [
    "games",
    "entertainment"
  ],
  "screenshots": [
    {
      "src": "/screenshot.jpg",
      "sizes": "1000x400",
      "type": "image/jpeg",
      "form_factor": "wide"
    }
  ],
  "shortcuts": [
    {
      "name": "Oyuna Başla",
      "short_name": "Oyna",
      "description": "Dərhal oyuna daxil ol",
      "url": "/index.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/index.html",
    "method": "GET",
    "params": {
      "title": "Beackroms",
      "text": "Beackrooms",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": "auto"
  },
  "file_handlers": [
    {
      "action": "/index.html",
      "accept": {
        "image/png": [
          ".png"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+backrooms",
      "url": "/index.html?value=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/index.html"
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.json"
    }
  ],
  "widgets": [
    {
      "name": "Backrooms Widget",
      "tag": "backrooms-widget",
      "template": "default",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "scope_extensions": [
    {
      "origin": "*"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "id": "/index.htmlhttps://github.com/smdovc7-dotcom/The-beakkin/blob/main/index.html",
  "scope": "Backrooms Oyunu",
  "orientation": "natural",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "iarc_rating_id": "/index.htmlhttps://github.com/smdovc7-dotcom/The-beakkin/blob/main/index.html",
  "prefer_related_applications": true
}

